{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LifePlan OY",
  "mainBinaryName": "lifeplan-oy",
  "version": "1.1.0",
  "identifier": "com.ouyangyu98.lifeplan",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LifePlan OY",
        "width": 1050,
        "height": 650,
        "minWidth": 1050,
        "minHeight": 650,
        "visible": true,
        "center": true,
        "focus": true,
        "resizable": true,
        "decorations": false,
        "shadow": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc0RTNDMzg2Rjk0NENFQ0UKUldUT3prVDVoc1BqZEUxN3pFd2FrVzltaDE5QzJQUFNxMnRrS1pWdEZLV0VYT3VxaG00ZG55ZlQK",
      "endpoints": [
        "https://github.com/ouyangyu98/LifePlan/releases/latest/download/latest.json"
      ]
    }
  }
}
